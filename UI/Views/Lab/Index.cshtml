@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    var selectItems = new SelectList(new List<ListDemo>
    {
        new ListDemo { Id = 1, Name = "a" },
        new ListDemo { Id = 2, Name = "b" },
        new ListDemo { Id = 3, Name = "c" },
    }, "Id", "Name");
}

<body>
    <div>
        <h3>@ViewData["Title"]</h3>
        <h2>Список</h2>
        <ol type="A">
            @for (var i = 0; i < 10; i++)
            {
                <li>
                    Элемент @i списка
                </li>
            }   
        </ol>
        <hr/>
        <h2>Форма</h2>
        <form method="post">
            
            <div class="row mb-3">
                <select name="select" asp-items="@selectItems"></select>
            </div>

            <div class="row mb-3 offset-sm-2">
                <div class="form-check">
                    <input type="checkbox" name="check1">
                    <label class="form-check-label">Чек-бокс 1</label>
                </div>
            </div>

            <div class="row mb-3 offset-sm-2">
                <div class="form-check">
                    <input type="checkbox" name="check2">
                    <label class="form-check-label">Чек-бокс 2</label>
                </div>
            </div>

            <div class="row mb-3 offset-sm-2">
                <div class="col-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio1" id="radio1">
                        <label class="form-check-label" for="radio1">Радио-1</label>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio2" id="radio2">
                        <label class="form-check-label" for="radio2">Радио-2</label>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radio3" id="radio3">
                        <label class="form-check-label" for="radio3">Радио-3</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <label for="inputLogin" class="col-sm-2 col-form-label">Логин</label>
                <div class="col-sm-10">
                    <input class="form-control" name="inputLogin" id="inputLogin">
                </div>
            </div>

            <div class="row mb-3">
                <label for="inputPass" class="col-sm-2 col-form-label">Пароль</label>
                <div class="col-sm-10">
                    <input type="password" class="form-control" name="inputPass" id="inputPass">
                </div>
            </div>

            <div class="row">
                <div class="col-4">
                    <button type="submit" class="btn btn-primary">Отправить</button>
                </div>
            </div>
        </form>
    </div>
</body>