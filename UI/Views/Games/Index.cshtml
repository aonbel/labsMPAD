@model ListModel<Game>

@{
    ViewData["Title"] = "Catalog";
    Layout = "_Layout";
}

<h1 class="my-4">Каталог игр</h1>

<div class="dropdown mb-4">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @if (ViewBag.CurrentGameGenre is null)
        {
            @:Все игры
        }
        else
        {
            @ViewBag.CurrentGameGenre.Name
        }
    </button>

    <ul class="dropdown-menu" aria-labelledby="genreDropdown">
        <li>
            <a class="dropdown-item"
               asp-controller="Games"
               asp-action="Index"
               asp-route-gameGenreId="@null">Все игры</a>
        </li>
        @foreach (var item in ViewBag.GameGenres)
        {
            <li>
                <a class="dropdown-item"
                   asp-controller="Games"
                   asp-action="Index"
                   asp-route-gameGenreId="@item.Id">
                    @item.Name
                </a>
            </li>
        }
    </ul>
</div>

<div id="games-menu">
    <partial name="_GamesMenu"/>
</div>