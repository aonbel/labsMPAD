<!DOCTYPE html>
<html lang="en">

<head>
    <title>@ViewData["Title"] - Labs</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"/>
</head>

<body>
<header>
    <nav class="navbar bg-white navbar-expand-md border-bottom border-body"
         data-bs-theme="light">
        <partial name="_MenuLayout"/>
        <partial name="_UserInfo"/>
    </nav>  
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="container">
        <div class="navbar bg-dark navbar-expand-md border-bottom border-body"
             data-bs-theme="dark">
            <div class="navbar-nav ms-auto">
                <a class="nav-item nav-link" href="https://www.facebook.com">
                    <i class="bi bi-facebook" style="font-size: 2rem"></i>
                </a>
                <a class="nav-item nav-link" href="https://www.twitch.tv">
                    <i class="bi bi-twitch" style="font-size: 2rem"></i>
                </a>
                <a class="nav-item nav-link" href="https://web.telegram.org">
                    <i class="bi bi-telegram" style="font-size: 2rem"></i>
                </a>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>